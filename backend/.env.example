PORT=5000

# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=foodbridge

# JWT
JWT_SECRET=your_super_secret_key
JWT_EXPIRES_IN=7d

# Email (using Gmail as example - use an "App Password", not your real password)
EMAIL_USER=youremail@gmail.com
EMAIL_PASS=your_app_password

# Google Maps API (used on frontend, but kept here for reference)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
