# Copy this file to .env and fill in real values.
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Use a long random string (for example: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# MySQL connection. `npm run db:setup` creates this database and user.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=capstone_grid
DB_USER=capstone_user
DB_PASSWORD=replace_with_a_strong_password
