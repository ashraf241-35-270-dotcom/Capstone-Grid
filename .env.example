# Optional. SQLite development works without a .env file.
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Use a long random string (for example: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# Local development uses a persistent SQLite file at backend/data/capstone-grid.sqlite by default.
DB_CLIENT=sqlite

# Optional: set DB_CLIENT=mysql to use the MySQL connection below.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=capstone_grid
DB_USER=capstone_user
DB_PASSWORD=replace_with_a_strong_password

# Configure SMTP to enable password reset emails.
# SMTP_SECURE=true for implicit TLS (usually port 465); false for STARTTLS/other SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
